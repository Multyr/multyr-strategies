# Foundry
cache/
out/
broadcast/*/
!broadcast/
!broadcast/**/dry-run/
# Address-book JSON written directly into broadcast/ (not a per-script
# subdirectory forge creates itself) -- e.g. STRATEGY_OUTPUT_JSON's default
# broadcast/strategy-addresses.json, and fork tests' own artifacts.
broadcast/*.json

# Environment
.env
.env.*
!.env.example
!.env.template
!.env.shadow.example

# Deployment records: keep manifests/address books (reproducibility evidence);
# ignore forge broadcast noise and the fork-test's fixed-id output.
deployments/**/run-*.json
deployments/**/cache/
deployments/shadow/forktest/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/

# Python (metadata tooling)
__pycache__/
*.pyc
.venv/

# Forge coverage
lcov.info

# Working outputs (test captures, result reports)
outputs/

# Private audit delivery packages (delivered via secure channel, never in public repo)
audit_p07_v*/
audit_p07_v*-*.zip
audit_p07_v*-*.sha256
evidence/

# Echidna corpus (generated, not committed selectively)
test/strategies/usdc-lending/echidna/corpus/

# Misnamed scripts/ dir (canonical dir is script/)
scripts/

# Top-level coverage build artifacts (root only, not docs/coverage/)
/coverage/

# Foundry extras
crytic-export/
foundry.lock

# Logs
*.log

# Audit submission packages (build artifacts, distributed via GitHub Release)
audit_p07_v*.zip
audit_p07_v*.zip.sha256
audit_p07_v*/

