diff --git a/script/CheckLendingRelease.ps1 b/script/CheckLendingRelease.ps1
new file mode 100644
index 0000000..a753542
--- /dev/null
+++ b/script/CheckLendingRelease.ps1
@@ -0,0 +1,80 @@
+param(
+    [string]$ReportPath = 'docs/lending-verification-20261031/candidate-structure.json',
+    [string]$OutputDirectory = 'deployments/lending-source-review-20261031/structure-out',
+    [string]$CachePath = 'deployments/lending-source-review-20261031/structure-cache.json'
+)
+$ErrorActionPreference = 'Stop'
+Set-Location (Split-Path $PSScriptRoot -Parent)
+$effectiveConfig = & forge config --json | ConvertFrom-Json
+if ($LASTEXITCODE -ne 0 -or $effectiveConfig.solc -ne '0.8.28' -or
+    $effectiveConfig.optimizer -ne $true -or $effectiveConfig.optimizer_runs -ne 200 -or
+    $effectiveConfig.via_ir -ne $true -or $effectiveConfig.evm_version -ne 'cancun' -or
+    $effectiveConfig.bytecode_hash -ne 'none' -or $effectiveConfig.cbor_metadata -ne $false) {
+    throw 'Unexpected release compiler settings'
+}
+$foundryVersion = (& forge --version | Select-Object -First 1).Trim()
+$inspectArguments = @('--skip', 'test', '--skip', 'script', '--extra-output', 'storageLayout')
+if ($OutputDirectory) { $inspectArguments += @('--out', $OutputDirectory) }
+if ($CachePath) { $inspectArguments += @('--cache-path', $CachePath) }
+$modules = @('UsdcMultiLendingVault','StrategyParamsModule','StrategyScoringModule',
+    'StrategyAdapterOpsModule','StrategyRebalanceGateModule','StrategyRebalancePlanModule',
+    'StrategyAllocCalcModule','StrategySafetyOverflowModule','StrategySettingsModule')
+$adapters = @('AaveV3USDCAdapter','CometUsdcMultiMarketAdapter','DolomiteUsdcMultiMarketAdapter',
+    'EulerUsdcMultiMarketAdapter','FluidUsdcMultiMarketAdapter','MorphoUsdcMultiMarketAdapter',
+    'VenusUsdcMultiMarketAdapter','RewardSwapHelper','StrategyBootstrapper','ReadOnlyGasEstimator','OPStackFeeInfo')
+function Inspect-Json($Name, $Field) {
+    $raw = & forge inspect $Name $Field --json @inspectArguments
+    if ($LASTEXITCODE -ne 0) { throw "forge inspect failed: $Name $Field" }
+    return ($raw -join "`n" | ConvertFrom-Json -AsHashtable)
+}
+function Layout-Rows($Layout) {
+    return @($Layout.storage | ForEach-Object {
+        [ordered]@{label=$_.label; slot=$_.slot; offset=$_.offset; type=$Layout.types[$_.type].label}
+    })
+}
+$sizes = [ordered]@{}
+$selectors = @{}
+$canonical = $null
+foreach ($name in ($modules + $adapters)) {
+    $code = (& forge inspect $name deployedBytecode @inspectArguments) -join ''
+    if ($LASTEXITCODE -ne 0) { throw "Bytecode inspection failed: $name" }
+    $code = $code.Trim()
+    if ($code -notmatch '^0x[0-9a-fA-F]+$') { throw "Unexpected bytecode for $name" }
+    $bytes = ($code.Length - 2) / 2
+    if ($bytes -gt 23552) { throw "$name exceeds project runtime buffer: $bytes" }
+    $sizes[$name] = $bytes
+    if ($name -in $modules) {
+        $methods = Inspect-Json $name 'methodIdentifiers'
+        foreach ($signature in $methods.Keys) {
+            $selector = $methods[$signature]
+            if ($selectors.ContainsKey($selector) -and $selectors[$selector] -ne $signature) {
+                throw "Selector collision: $signature / $($selectors[$selector])"
+            }
+            $selectors[$selector] = $signature
+        }
+        $rows = Layout-Rows (Inspect-Json $name 'storageLayout')
+        $serialized = ConvertTo-Json -InputObject $rows -Depth 20 -Compress
+        if ($null -eq $canonical) { $canonical = $serialized }
+        elseif ($serialized -ne $canonical) { throw "Module storage mismatch: $name" }
+    }
+}
+$appendChecks = [ordered]@{}
+foreach ($name in @('CometUsdcMultiMarketAdapter','RewardSwapHelper')) {
+    $baseline = Get-Content -LiteralPath "test/strategies/usdc-lending/adapters/snapshots/$name.storage.json" -Raw | ConvertFrom-Json -AsHashtable
+    $oldRows = Layout-Rows $baseline
+    $newRows = Layout-Rows (Inspect-Json $name 'storageLayout')
+    if ($newRows.Count -lt $oldRows.Count) { throw "Storage removed: $name" }
+    for ($i=0; $i -lt $oldRows.Count; $i++) {
+        if ((ConvertTo-Json -InputObject $oldRows[$i] -Compress) -ne (ConvertTo-Json -InputObject $newRows[$i] -Compress)) {
+            throw "Existing storage moved: $name index $i"
+        }
+    }
+    $appendChecks[$name] = @{preservedFields=$oldRows.Count; appendedFields=$newRows.Count-$oldRows.Count}
+}
+$report = [ordered]@{foundry=$foundryVersion; solc='0.8.28'; optimizerRuns=200; viaIR=$true; evmVersion='cancun';
+    runtimeLimitBytes=23552; runtimeBytes=$sizes; uniqueSelectors=$selectors.Count;
+    distinctSignatureCollisions=0; identicalModuleLayouts=$modules.Count; appendOnly=$appendChecks;
+    strategyReferenceUnitLast=($rows[-1].label -eq 'referenceUnit'); strategyReferenceUnitSlot=$rows[-1].slot}
+if (-not $report.strategyReferenceUnitLast) { throw 'referenceUnit must be the last strategy storage entry' }
+$report | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $ReportPath -Encoding utf8
+$report | ConvertTo-Json -Depth 20
diff --git a/script/DeployLendingStrategy.s.sol b/script/DeployLendingStrategy.s.sol
new file mode 100644
index 0000000..31dcf54
--- /dev/null
+++ b/script/DeployLendingStrategy.s.sol
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: BUSL-1.1
+pragma solidity 0.8.28;
+
+import {DeployUsdcLendingStrategy} from "./DeployUsdcLendingStrategy.s.sol";
+import {GasEstimatorPreflight} from "./GasEstimatorPreflight.sol";
+import {UsdcLendingChainConfig} from "../src/strategies/usdc-lending/config/UsdcLendingChainConfig.sol";
+import {UsdcMultiLendingVault} from "../src/strategies/usdc-lending/controller/UsdcLendingStrategy.sol";
+import {StrategySettingsModule} from "../src/strategies/usdc-lending/controller/StrategySettingsModule.sol";
+import {StrategyParamsModule} from "../src/strategies/usdc-lending/controller/StrategyParamsModule.sol";
+import {StrategyBootstrapper} from "../src/strategies/usdc-lending/StrategyBootstrapper.sol";
+import {AdapterFactory} from "../src/strategies/usdc-lending/factory/AdapterFactory.sol";
+import {RewardSwapHelper} from "../src/strategies/usdc-lending/swap/RewardSwapHelper.sol";
+import {ILendingAdapter, IStrategyAssetValuation} from "../src/strategies/usdc-lending/interfaces/ILendingAdapter.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {IAccessControl} from "@openzeppelin/contracts/access/IAccessControl.sol";
+
+interface ILendingAdapterVault { function vault() external view returns (address); }
+interface ILendingCoreAsset { function asset() external view returns (address); }
+interface ILendingModuleIdentity {
+    function ASSET() external view returns (address);
+    function core() external view returns (address);
+}
+
+/// @notice Typed, chain/asset-independent candidate deployment. Core activation is a
+///         separate governance operation. A reviewed manifest must pin every bytecode hash.
+contract DeployLendingStrategy is DeployUsdcLendingStrategy {
+    struct AdapterSpec {
+        bytes creationCode;
+        bytes32 creationHash;
+        bytes32 runtimeHash;
+        bytes32 salt;
+        bytes initializer;
+        bytes[] configuration;
+        bool usesRewardHelper;
+    }
+    struct RewardSpec {
+        address token;
+        address usdFeed;
+        uint32 maxAge;
+        bytes uniPath;
+        bytes camelotPath;
+        uint16 slippageBps;
+    }
+    struct Manifest {
+        uint256 chainId;
+        address asset;
+        address coreVault;
+        address router;
+        address governance;
+        address guardian;
+        address keeper;
+        bytes32 salt;
+        address estimator;
+        address ethUsdFeed;
+        address usdQuoteFeed; // Optional legacy estimator binding; zero is supported.
+        address feeSource;
+        bytes arbitrumFeeSnapshot;
+        address assetUsdFeed;
+        address sequencerFeed;
+        bytes32 estimatorConfigHash;
+        uint16 targetIdleBps;
+        UsdcMultiLendingVault.StrategyInitParams parameters;
+        AdapterSpec[] adapters;
+        address uniRouter;
+        address camelotRouter;
+        uint32 assetFeedMaxAge;
+        RewardSpec[] rewards;
+    }
+
+    UsdcMultiLendingVault.StrategyInitParams private reviewedParameters;
+    event CandidateManifest(bytes32 indexed manifestHash, uint256 indexed chainId, address indexed asset,
+        address strategy, address rewardHelper);
+    event CandidateAdapter(address indexed strategy, address indexed adapter, bytes32 runtimeHash);
+
+    function run() external pure override returns (DeploymentResult memory) {
+        revert("TYPED_MANIFEST_REQUIRED");
+    }
+
+    function run(Manifest calldata m) external returns (DeploymentResult memory result) {
+        // Forge cannot execute ArbOS's native fee precompile. The reviewed public
+        // RPC snapshot affects local simulation only and is included in the manifest hash.
+        if (block.chainid == 42161 && m.feeSource == address(0x6c)) {
+            require(m.arbitrumFeeSnapshot.length == 192, "ARBITRUM_FEE_SNAPSHOT_REQUIRED");
+            vm.mockCall(address(0x6c), abi.encodeWithSignature("getPricesInWei()"), m.arbitrumFeeSnapshot);
+        }
+        _preflight(m);
+        DeployConfig memory cfg;
+        cfg.deployerPk = vm.envUint("DEPLOYER_PRIVATE_KEY");
+        cfg.deployer = vm.addr(cfg.deployerPk);
+        cfg.vault = m.coreVault;
+        cfg.strategyRouter = m.router;
+        cfg.governance = m.governance;
+        cfg.guardian = m.guardian;
+        reviewedParameters = m.parameters;
+        UsdcLendingChainConfig memory chainCfg;
+        // Legacy struct field name only; the value is the manifest's actual asset.
+        chainCfg.usdc = m.asset;
+        chainCfg.deploySalt = keccak256(abi.encode(m.chainId, m.asset, m.salt));
+
+        vm.startBroadcast(cfg.deployerPk);
+        result = _phase1_deployModulesAndStrategy(cfg, chainCfg);
+        result = _phase1_7_deployOptionalModules(cfg, result, chainCfg);
+        _verifyModules(result, m.asset, m.coreVault);
+        StrategySettingsModule settings = StrategySettingsModule(address(result.strategy));
+        _validateInitialSettings(settings, m.parameters);
+        settings.setRebalanceGasEstimator(m.estimator);
+        settings.setTargetIdleBufferBps(m.targetIdleBps);
+        // Prove the fresh core valuation works through the real fallback/delegatecall path.
+        IStrategyAssetValuation(address(result.strategy)).assetUnitsToUsd6(10 ** IERC20Metadata(m.asset).decimals());
+
+        address helper = _deployRewardHelper(m, result);
+        address[] memory adapters = new address[](m.adapters.length);
+        AdapterFactory factory = AdapterFactory(result.adapterFactory);
+        for (uint256 i; i < m.adapters.length; ++i) {
+            AdapterSpec calldata spec = m.adapters[i];
+            address adapter = factory.deployAndInit(spec.creationCode, spec.salt, spec.initializer);
+            require(adapter.code.length <= 23552, "ADAPTER_SIZE_BUFFER");
+            require(adapter.codehash == spec.runtimeHash, "ADAPTER_RUNTIME_HASH");
+            require(ILendingAdapter(adapter).underlying() == m.asset, "ADAPTER_ASSET");
+            require(ILendingAdapterVault(adapter).vault() == address(result.strategy), "ADAPTER_VAULT");
+            for (uint256 j; j < spec.configuration.length; ++j) {
+                (bool ok, bytes memory reason) = adapter.call(spec.configuration[j]);
+                if (!ok) { assembly ("memory-safe") { revert(add(reason, 32), mload(reason)) } }
+            }
+            if (spec.usesRewardHelper) {
+                require(helper != address(0), "REWARD_HELPER_REQUIRED");
+                (bool ok,) = adapter.call(abi.encodeWithSignature("setSwapHelper(address)", helper));
+                require(ok, "REWARD_HELPER_WIRING");
+                RewardSwapHelper(payable(helper)).grantRole(keccak256("KEEPER_ROLE"), adapter);
+            }
+            require(ILendingAdapter(adapter).underlying() == m.asset, "CONFIGURED_ADAPTER_ASSET");
+            require(ILendingAdapterVault(adapter).vault() == address(result.strategy), "CONFIGURED_ADAPTER_VAULT");
+            adapters[i] = adapter;
+            emit CandidateAdapter(address(result.strategy), adapter, spec.runtimeHash);
+        }
+        StrategyBootstrapper(payable(result.bootstrapper)).bootstrap(adapters);
+        bytes32 keeperRole = keccak256("KEEPER_ROLE");
+        result.strategy.grantRole(keeperRole, cfg.deployer);
+        StrategyParamsModule(address(result.strategy)).pokeExternalTVL();
+        StrategyParamsModule(address(result.strategy)).pokeLiquidityBatch(0, adapters.length);
+        result.strategy.grantRole(keeperRole, m.keeper);
+        if (cfg.deployer != m.keeper && cfg.deployer != m.guardian) {
+            result.strategy.renounceRole(keeperRole, cfg.deployer);
+        }
+        for (uint256 i; i < adapters.length; ++i) _handoff(adapters[i], cfg);
+        if (helper != address(0)) _handoff(helper, cfg);
+        _phase3_6_handoffGovernance(cfg, result);
+        vm.stopBroadcast();
+        emit CandidateManifest(keccak256(abi.encode(m)), m.chainId, m.asset, address(result.strategy), helper);
+    }
+
+    function _preflight(Manifest calldata m) internal view {
+        require(m.chainId == block.chainid, "MANIFEST_CHAIN");
+        require(m.asset.code.length > 0 && m.coreVault.code.length > 0 && m.router.code.length > 0, "MISSING_CODE");
+        require(ILendingCoreAsset(m.coreVault).asset() == m.asset, "CORE_ASSET");
+        require(m.governance != address(0) && m.keeper != address(0), "MISSING_AUTHORITY");
+        uint8 decimals = IERC20Metadata(m.asset).decimals();
+        require(decimals > 0 && decimals <= 18, "UNSUPPORTED_DECIMALS");
+        require(m.targetIdleBps <= 10000 && m.adapters.length > 0 && m.adapters.length <= 7, "INVALID_POLICY");
+        GasEstimatorPreflight.validateForSource(m.estimator, m.governance, m.ethUsdFeed, m.usdQuoteFeed,
+            m.sequencerFeed, m.estimatorConfigHash, m.feeSource);
+        for (uint256 i; i < m.adapters.length; ++i) {
+            AdapterSpec calldata spec = m.adapters[i];
+            require(spec.creationCode.length > 0 && keccak256(spec.creationCode) == spec.creationHash, "ADAPTER_CREATION_HASH");
+            require(spec.runtimeHash != bytes32(0) && spec.initializer.length >= 4, "ADAPTER_MANIFEST");
+            for (uint256 j; j < i; ++j) require(spec.salt != m.adapters[j].salt, "DUPLICATE_ADAPTER_SALT");
+        }
+        if (m.rewards.length > 0) {
+            require(m.uniRouter.code.length > 0 && m.assetUsdFeed.code.length > 0, "REWARD_INFRASTRUCTURE");
+            require(m.camelotRouter == address(0) || m.camelotRouter.code.length > 0, "CAMELOT_CODE");
+        }
+    }
+
+    function _verifyModules(DeploymentResult memory r, address asset, address coreVault) internal view {
+        address[9] memory modules = [address(r.strategy), r.paramsModule, r.scoringModule,
+            r.adapterOpsModule, r.rebalanceGateModule, r.settingsModule, r.allocCalcModule,
+            r.rebalancePlanModule, r.safetyOverflowModule];
+        for (uint256 i; i < modules.length; ++i) {
+            require(modules[i].code.length > 0 && modules[i].code.length <= 23552, "MODULE_SIZE_BUFFER");
+            require(ILendingModuleIdentity(modules[i]).ASSET() == asset, "MODULE_ASSET");
+            require(ILendingModuleIdentity(modules[i]).core() == coreVault, "MODULE_CORE");
+        }
+    }
+
+    /// @dev Reapply the constructor inputs through the canonical guarded setters.
+    ///      This rejects malformed monetary/BPS configurations instead of trusting a manifest label.
+    function _validateInitialSettings(StrategySettingsModule settings,
+        UsdcMultiLendingVault.StrategyInitParams calldata p) internal
+    {
+        settings.setRiskWeights(p.wAPY, p.wLiq, p.wRisk, p.wStability, p.wIncentive);
+        settings.setRebalanceParams(p.maxAdaptersPerAllocation, p.minAdaptersActive,
+            p.rebalanceMinMoveBps, p.minSecondsBetweenRebalances, p.driftToleranceBps,
+            p.adapterMaxExposureBps, p.newAdapterRampBps);
+        settings.setGateParams(p.gateHorizonDays, p.gateMinNetBenefitBps,
+            p.slippageBpsEstimate, p.withdrawalSpreadBpsEstimate, p.gasCostUSDC);
+        settings.setHarvestParams(p.harvestThresholdBps, p.minSecondsBetweenHarvests);
+        settings.setDustTolerance(p.dustTolerance);
+    }
+
+    function _deployRewardHelper(Manifest calldata m, DeploymentResult memory result) internal returns (address helper) {
+        if (m.rewards.length == 0) return address(0);
+        helper = AdapterFactory(result.adapterFactory).deployAndInit(type(RewardSwapHelper).creationCode,
+            keccak256(abi.encode(m.chainId, m.asset, m.salt, "rewards")),
+            abi.encodeCall(RewardSwapHelper.initializeAsset, (m.asset, vm.addr(vm.envUint("DEPLOYER_PRIVATE_KEY")), m.uniRouter, m.camelotRouter)));
+        RewardSwapHelper h = RewardSwapHelper(payable(helper));
+        h.setOutputAssetOracle(m.assetUsdFeed, m.assetFeedMaxAge);
+        if (m.sequencerFeed != address(0)) h.setSequencerUptimeFeed(m.sequencerFeed);
+        for (uint256 i; i < m.rewards.length; ++i) {
+            RewardSpec calldata r = m.rewards[i];
+            (bool ok, bytes memory data) = r.usdFeed.staticcall(abi.encodeWithSignature("decimals()"));
+            require(ok && data.length == 32, "REWARD_FEED");
+            h.setRewardConfig(r.token, r.usdFeed, abi.decode(data, (uint8)), IERC20Metadata(r.token).decimals(),
+                r.maxAge, r.uniPath, r.camelotPath, r.slippageBps);
+            require(h.canSwap(r.token), "REWARD_ORACLE_NOT_READY");
+        }
+    }
+
+    function _handoff(address target, DeployConfig memory cfg) internal {
+        IAccessControl controlled = IAccessControl(target);
+        bytes32 param = keccak256("PARAM_ROLE");
+        controlled.grantRole(bytes32(0), cfg.governance);
+        bool hasParam = controlled.hasRole(param, cfg.deployer);
+        if (hasParam) controlled.grantRole(param, cfg.governance);
+        if (cfg.deployer != cfg.governance) {
+            if (hasParam) controlled.renounceRole(param, cfg.deployer);
+            controlled.renounceRole(bytes32(0), cfg.deployer);
+        }
+        require(controlled.hasRole(bytes32(0), cfg.governance), "GOVERNANCE_ADMIN");
+        require(cfg.deployer == cfg.governance || !controlled.hasRole(bytes32(0), cfg.deployer), "DEPLOYER_ADMIN_REMAINS");
+    }
+
+    function _defaultParams() internal view override returns (UsdcMultiLendingVault.StrategyInitParams memory) {
+        return reviewedParameters;
+    }
+}
diff --git a/script/ExportLendingCandidate.ps1 b/script/ExportLendingCandidate.ps1
new file mode 100644
index 0000000..0e2f76f
--- /dev/null
+++ b/script/ExportLendingCandidate.ps1
@@ -0,0 +1,49 @@
+param([string]$Destination = 'deployments/lending-source-review-20261031')
+$ErrorActionPreference = 'Stop'
+Set-Location (Split-Path $PSScriptRoot -Parent)
+$base = (& git rev-parse HEAD).Trim()
+if ($base -ne '211f1a0a4cb9c63232ae18dac24ccb921e5a4699') { throw 'Unexpected candidate base' }
+$branch = (& git branch --show-current).Trim()
+if ($branch -ne 'codex/lending-multitoken-multichain') { throw 'Unexpected candidate branch' }
+& git diff --quiet --ignore-submodules=none -- lib
+if ($LASTEXITCODE -ne 0) { throw 'Frozen dependency checkout is dirty or moved' }
+New-Item -ItemType Directory -Path $Destination -Force | Out-Null
+$changed = @(& git diff --name-only HEAD)
+$added = @(& git ls-files --others --exclude-standard)
+$patch = [Text.StringBuilder]::new()
+foreach ($line in @(& git diff --binary --no-ext-diff HEAD)) { [void]$patch.Append($line).Append("`n") }
+if ($LASTEXITCODE -ne 0) { throw 'Tracked diff export failed' }
+foreach ($file in $added) {
+    foreach ($line in @(& git diff --no-index --binary --no-ext-diff -- /dev/null $file)) { [void]$patch.Append($line).Append("`n") }
+    if ($LASTEXITCODE -notin @(0,1)) { throw "New-file diff export failed: $file" }
+}
+$encoding = [Text.UTF8Encoding]::new($false)
+$patchPath = Join-Path $Destination 'candidate.patch'
+[IO.File]::WriteAllText((Join-Path (Get-Location) $patchPath), $patch.ToString(), $encoding)
+& git apply --check --reverse -- $patchPath
+if ($LASTEXITCODE -ne 0) { throw 'Exported patch does not reverse-check against candidate' }
+$entries = @(@($changed + $added) | Sort-Object -Unique | ForEach-Object {
+    if (Test-Path -LiteralPath $_ -PathType Leaf) {
+        $normalized = [IO.File]::ReadAllText((Join-Path (Get-Location) $_)).Replace("`r`n", "`n")
+        $digest = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($normalized))).ToLowerInvariant()
+        [ordered]@{path=$_; utf8LfSha256=$digest; rawSha256=(Get-FileHash -LiteralPath $_ -Algorithm SHA256).Hash.ToLowerInvariant(); bytes=(Get-Item -LiteralPath $_).Length}
+    } else { [ordered]@{path=$_; deleted=$true} }
+})
+$manifest = [ordered]@{baseCommit=$base; branch=$branch;
+    frozenCoreCommit='9a9d120709de99a6216e9fe75d36e9ffdcb1a4d9';
+    hashPolicy='Verify utf8LfSha256 after decoding UTF-8 and normalizing CRLF to LF; rawSha256 is same-host diagnostic only'; files=$entries}
+$validationPath = 'docs/lending-verification-20261031/final-validation.json'
+if (Test-Path -LiteralPath $validationPath) {
+    $validation = Get-Content -LiteralPath $validationPath -Raw | ConvertFrom-Json
+    $functional = @($entries | Where-Object { $_.path -match '^(src|test|script)/.*\.sol$' -or $_.path -eq 'foundry.toml' } |
+        Sort-Object { $_['path'] } | ForEach-Object { $_['path'] + ' ' + $_['utf8LfSha256'] })
+    $functionalHash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes(($functional -join "`n") + "`n"))).ToLowerInvariant()
+    if ($functionalHash -ne $validation.functionalSnapshotSha256) { throw 'Functional source changed since recorded validation; rerun tests and refresh the ledger' }
+}
+$manifestPath = Join-Path $Destination 'candidate-files.json'
+[IO.File]::WriteAllText((Join-Path (Get-Location) $manifestPath), ($manifest | ConvertTo-Json -Depth 10), $encoding)
+$checksums = foreach ($path in @($patchPath,$manifestPath)) {
+    (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() + ' *' + (Split-Path $path -Leaf)
+}
+[IO.File]::WriteAllText((Join-Path (Get-Location) (Join-Path $Destination 'candidate-bundle.sha256')), ($checksums -join "`n")+"`n", $encoding)
+[ordered]@{files=$entries.Count; patchBytes=(Get-Item -LiteralPath $patchPath).Length; checksums=$checksums} | ConvertTo-Json
diff --git a/script/ReproduceLendingRuntime.ps1 b/script/ReproduceLendingRuntime.ps1
new file mode 100644
index 0000000..8136ba1
--- /dev/null
+++ b/script/ReproduceLendingRuntime.ps1
@@ -0,0 +1,58 @@
+param(
+    [Parameter(Mandatory=$true)][string]$SolcPath,
+    [string]$RpcUrl = 'https://arbitrum-one.public.blastapi.io',
+    [uint64]$Block = 520094008
+)
+$ErrorActionPreference = 'Stop'
+$root = Split-Path $PSScriptRoot -Parent
+$original = Join-Path $root 'deployments/ema-first-20261023/allocator-exact-input.json'
+$outDir = Join-Path $root 'deployments/lending-source-review-20261031'
+New-Item -ItemType Directory -Path $outDir -Force | Out-Null
+$targets = [ordered]@{
+    StrategyParamsModule='0x9DdbFF7a2D6cbfdA7fE5Fe72A7e7A09eef8F2772'
+    StrategyScoringModule='0x5Aa4d01CEe130f5C5CfADd091c1aFF12496f7A01'
+    StrategyAdapterOpsModule='0xe55fB758f1B7e418670849AF812A1B9C80b40f59'
+    StrategyRebalanceGateModule='0x7aa669f8Ef61071Cd5FA2b30f26B5ba5Cd741Fc2'
+    StrategySettingsModule='0xbF0541cFd02933825739e64FD618Bdd5155D77f9'
+    StrategyRebalancePlanModule='0x32631c98C8CeA03e69285d9cA6cf2A9d516231C5'
+    StrategySafetyOverflowModule='0x5FC0ae46a8c9e15C08553b55Fd3033AC500caA7d'
+    StrategyAllocCalcModule='0x08a1eb6FC01042447A35CA59c3c00c588C41A878'
+    UsdcMultiLendingVault='0x2AD722B6241605481829E4B251AE8A4Ba8Be86cE'
+}
+$inputObject = Get-Content -LiteralPath $original -Raw | ConvertFrom-Json
+$selection = @{}
+foreach ($name in $targets.Keys) {
+    $file = if ($name -eq 'UsdcMultiLendingVault') { 'UsdcLendingStrategy' } else { $name }
+    $source = 'src/strategies/usdc-lending/controller/' + $file + '.sol'
+    $selection[$source] = @{ $name=@('evm.deployedBytecode.object','evm.deployedBytecode.immutableReferences'); ''=@('ast') }
+}
+$selection['src/strategies/usdc-lending/controller/StrategyStorageLayout.sol'] = @{ ''=@('ast') }
+# Preserve the complete original source graph. Pruning it changes via-IR codegen
+# identities and fails exact runtime reproduction even with identical target text.
+$inputObject.settings.outputSelection = $selection
+$inputJson = $inputObject | ConvertTo-Json -Depth 100 -Compress
+$inputPath = Join-Path $outDir 'live-modules-input.json'
+$outputPath = Join-Path $outDir 'live-modules-output.json'
+$inputJson | Set-Content -LiteralPath $inputPath -Encoding utf8
+$compiler = (Resolve-Path -LiteralPath $SolcPath).Path
+$temporaryCompiler = $null
+try {
+    # Foundry's Windows SVM binary has no .exe extension; PowerShell otherwise
+    # treats it as a document in a pipeline. Copy the same local binary to temp.
+    if ($IsWindows -and [IO.Path]::GetExtension($compiler) -ne '.exe') {
+        $temporaryCompiler = Join-Path $env:TEMP ('multyr-solc-audit-' + [guid]::NewGuid().ToString('N') + '.exe')
+        Copy-Item -LiteralPath $compiler -Destination $temporaryCompiler
+        $compiler = $temporaryCompiler
+    }
+    $version = & $compiler --version
+    if ($LASTEXITCODE -ne 0 -or ($version -join ' ') -notmatch '0\.8\.28\+commit\.7893614a') { throw 'Requires exact solc 0.8.28 build' }
+    $inputJson | & $compiler --standard-json | Set-Content -LiteralPath $outputPath -Encoding utf8
+    if ($LASTEXITCODE -ne 0) { throw 'Compiler failed' }
+    foreach ($entry in $targets.GetEnumerator()) {
+        & (Join-Path $PSScriptRoot 'VerifyPinnedRuntime.ps1') -Contract $entry.Key -Address $entry.Value `
+            -CompilerInput $inputPath -CompilerOutput $outputPath `
+            -ProofPath (Join-Path $outDir ($entry.Key + '-proof.json')) -Block $Block -RpcUrl $RpcUrl
+    }
+} finally {
+    if ($null -ne $temporaryCompiler) { Remove-Item -LiteralPath $temporaryCompiler -ErrorAction SilentlyContinue }
+}
diff --git a/script/VerifyPinnedRuntime.ps1 b/script/VerifyPinnedRuntime.ps1
new file mode 100644
index 0000000..9310d62
--- /dev/null
+++ b/script/VerifyPinnedRuntime.ps1
@@ -0,0 +1,75 @@
+param(
+    [Parameter(Mandatory=$true)][string]$Contract,
+    [Parameter(Mandatory=$true)][string]$Address,
+    [Parameter(Mandatory=$true)][string]$CompilerOutput,
+    [Parameter(Mandatory=$true)][string]$CompilerInput,
+    [Parameter(Mandatory=$true)][string]$ProofPath,
+    [uint64]$Block = 520094008,
+    [string]$RpcUrl = 'https://arb1.arbitrum.io/rpc'
+)
+$ErrorActionPreference = 'Stop'
+$compiled = Get-Content -LiteralPath $CompilerOutput -Raw | ConvertFrom-Json
+if (@($compiled.errors | Where-Object severity -eq 'error').Count -gt 0) { throw 'Compiler errors in supplied output' }
+$targets = @($compiled.contracts.PSObject.Properties | Where-Object { $_.Value.PSObject.Properties.Name -contains $Contract })
+if ($targets.Count -ne 1) { throw 'Contract output must be unambiguous' }
+$runtime = $targets[0].Value.$Contract.evm.deployedBytecode
+$expected = $runtime.object.ToLowerInvariant()
+$observed = & cast code $Address --block $Block --rpc-url $RpcUrl
+if ($LASTEXITCODE -ne 0) { throw 'Pinned runtime query failed' }
+$observed = $observed.Trim().ToLowerInvariant()
+if ($observed -notmatch '^0x[0-9a-f]+$') { throw 'Invalid runtime response' }
+$actual = $observed.Substring(2)
+$names = @{}
+function Visit-Immutable($node) {
+    if ($null -eq $node) { return }
+    if ($node -is [System.Management.Automation.PSCustomObject]) {
+        if ($node.nodeType -eq 'VariableDeclaration' -and $node.mutability -eq 'immutable') {
+            $names[[string]$node.id] = $node.name
+        }
+        foreach ($property in $node.PSObject.Properties) { Visit-Immutable $property.Value }
+    } elseif ($node -is [System.Collections.IEnumerable] -and $node -isnot [string]) {
+        foreach ($item in $node) { Visit-Immutable $item }
+    }
+}
+foreach ($source in $compiled.sources.PSObject.Properties) { Visit-Immutable $source.Value.ast }
+$bindings = @()
+$bindingErrors = @()
+foreach ($reference in $runtime.immutableReferences.PSObject.Properties) {
+    $name = $names[$reference.Name]
+    if (!$name) { throw "No AST identity for immutable $($reference.Name)" }
+    if ($name -eq '_self') { $value = $Address }
+    else {
+        $value = & cast call $Address ($name + '()(address)') --block $Block --rpc-url $RpcUrl
+        if ($LASTEXITCODE -ne 0) { throw "Immutable getter query failed: $name" }
+    }
+    $value = $value.Trim().ToLowerInvariant()
+    if ($value -notmatch '^0x[0-9a-f]{40}$') { throw "Not an address binding: $name" }
+    $encoded = $value.Substring(2).PadLeft(64, '0')
+    foreach ($range in $reference.Value) {
+        if ($range.length -ne 32) { throw 'Unexpected immutable width' }
+        $offset = [int]$range.start * 2
+        if ($actual.Length -lt $offset + 64 -or $actual.Substring($offset, 64) -ne $encoded) {
+            $bindingErrors += [ordered]@{ name=$name; byteOffset=$range.start; expected=$encoded }
+        }
+        $expected = $expected.Remove($offset, 64).Insert($offset, $encoded)
+    }
+    $bindings += [ordered]@{ astId=$reference.Name; name=$name; value=$value; ranges=$reference.Value }
+}
+function Get-RuntimeHash([string]$hex) {
+    $paramsJson = ConvertTo-Json -InputObject @($hex) -Compress
+    $hash = $paramsJson | & cast rpc web3_sha3 --raw --rpc-url $RpcUrl
+    if ($LASTEXITCODE -ne 0) { throw 'Keccak query failed' }
+    return ($hash | ConvertFrom-Json)
+}
+$blockHash = & cast block $Block --field hash --rpc-url $RpcUrl
+if ($LASTEXITCODE -ne 0) { throw 'Block hash query failed' }
+$proof = [ordered]@{
+    contract=$Contract; address=$Address; block=$Block; blockHash=$blockHash.Trim();
+    compilerInputSha256=(Get-FileHash -LiteralPath $CompilerInput -Algorithm SHA256).Hash.ToLowerInvariant();
+    runtimeBytes=$actual.Length/2; compiledRuntimeBytes=$expected.Length/2; observedKeccak=Get-RuntimeHash $observed;
+    compiledBoundKeccak=Get-RuntimeHash ('0x' + $expected);
+    immutableBindings=$bindings; immutableBindingErrors=$bindingErrors; exactRuntimeMatch=($expected -ceq $actual)
+}
+$proof | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $ProofPath -Encoding utf8
+[PSCustomObject]@{ Contract=$Contract; ExactMatch=$proof.exactRuntimeMatch; Bytes=$proof.runtimeBytes }
+if (!$proof.exactRuntimeMatch) { throw 'Compiled runtime does not match pinned chain runtime' }
