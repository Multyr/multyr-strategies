+name: Lending asset matrix
+
+on:
+  pull_request:
+    paths:
+      - 'src/strategies/usdc-lending/**'
+      - 'script/**'
+      - 'foundry.toml'
+      - 'lib/multyr-core'
+      - '.gitmodules'
+      - 'test/strategies/usdc-lending/**'
+      - '.github/workflows/lending-asset-matrix.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  pinned-market-roundtrips:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive
+      - uses: foundry-rs/foundry-toolchain@v1
+        with:
+          version: v1.4.2
+      - name: USDC and WETH on Arbitrum and Base (adapter, strategy, core and swaps)
+        run: forge test --match-contract 'Lending((Asset|Strategy|Core)Matrix|RewardRoutes)ForkTest' -vv --summary
+      - name: Actual frozen router and explicit legacy migration rejection
+        env:
+          RUN_ROUTER_HARVEST_FORK: 'true'
+          ROUTER_HARVEST_RPC: https://arbitrum-one.public.blastapi.io
+          ROUTER_HARVEST_BLOCK: '520094008'
+        run: forge test --match-contract 'RouterHarvestForkTest|StrategySettingsCopyTest' --match-test 'test_deployedRouterHarvestAndRecallWithUnchangedCoreCode|test_liveDeprecatedDiversificationRequiresExplicitMigration' -vv --summary
+      - name: Generic manifest deployment and complete role handoff
+        run: forge test --match-contract LendingDeploymentManifestTest -vv --summary
