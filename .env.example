# ══════════════════════════════════════════════════════════════════════════
# USDC Lending Strategy — deployment environment
# ══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in before running script/deploy-usdc-lending.sh
# (or `forge script script/DeployUsdcLendingStrategy.s.sol` directly).
#
# Target chain: Arbitrum One only (chainId 42161) — the script hard-reverts
# on any other chain. Core system (CoreVault/StrategyRouter/BufferManager/
# StrategyHealthRegistry) must already be deployed via
# multyr-core/script/DeployCoreSystem.s.sol before running this.
# ══════════════════════════════════════════════════════════════════════════

# ── RPC / broadcast ─────────────────────────────────────────────────────────
RPC_URL=                       # Arbitrum One archive RPC endpoint
# Etherscan V2 unified API key -- one key verifies contracts on any chain,
# including Arbitrum (chainId 42161), no per-chain key needed. Required only
# when passing --verify to deploy-usdc-lending.sh / forge script.
ETHERSCAN_API_KEY=

# ── Required: deployer + core system addresses ──────────────────────────────
# Deployer EOA must be `owner` on both CoreVault and StrategyRouter -- neither
# uses AccessControl/hasRole (CoreVault is a Diamond-lite thin proxy with a
# plain two-step owner: owner()/pendingOwner()/acceptOwnership(); calling
# hasRole() on it reverts with ModuleNotSet() since that selector isn't
# registered in its fallback dispatch. StrategyRouter has its own single-step
# `owner` variable, unrelated to CoreVault's).
DEPLOYER_PRIVATE_KEY=          # hex, with 0x prefix
VAULT_ADDRESS=                 # CoreVault address (from DeployCoreSystem output)
STRATEGY_ROUTER_ADDRESS=       # StrategyRouter address
BUFFER_MANAGER_ADDRESS=        # BufferManager address
HEALTH_REGISTRY_ADDRESS=       # StrategyHealthRegistry address
GUARDIAN_ADDRESS=              # guardian multisig — receives pause/emergency powers

# ── Required only if DO_SEAL=true (final ownership handoff) ────────────────
TIMELOCK_ADDRESS=              # ROOT_TIMELOCK (TimelockController) — final admin owner
SELECTOR_REGISTRY_ADDRESS=     # SelectorRegistry
SYSTEM_SEALER_ADDRESS=         # SystemSealer

# ── Optional: ecosystem wiring (defaults to address(0) if unset) ───────────
INCENTIVES_ADDRESS=            # Incentives module, or leave blank
VETOER_ADDRESS=                # Vetoer address, or leave blank

# ── Optional: deploy flags (all default to the value shown) ────────────────
DO_SEAL=false                  # true = run Phase 5 (seal + transfer admin to timelock)
DEPLOY_UPKEEP=true             # true = deploy StrategyUpkeep + grant KEEPER_ROLE
DEPLOY_LENDING_ADAPTERS=true   # true = deploy all 7 adapters + run bootstrap
UNPAUSE_BUFFER=true            # true = unpause BufferManager after wiring (Phase 4)

# ── Optional: strategy parameters ───────────────────────────────────────────
# uint16, 0-5000 (50%). The constructor path itself doesn't enforce a ceiling,
# but any later governance adjustment goes through
# StrategySettingsModule.setRebalanceParams, which reverts with
# ParamOutOfRange() above 5000 -- so a value above 5000 here is settable at
# deploy time but not re-settable afterward. Keep it <= 5000.
ADAPTER_MAX_EXPOSURE_BPS=5000

# ── Optional: output ─────────────────────────────────────────────────────
STRATEGY_OUTPUT_JSON=          # address-book output path (default: broadcast/strategy-addresses.json)

# ══════════════════════════════════════════════════════════════════════════
# Standalone StrategyUpkeep redeploy (script/DeployStrategyUpkeep.s.sol)
# Only needed if redeploying the keeper without touching the strategy.
# ══════════════════════════════════════════════════════════════════════════
# STRATEGY_ADDRESS=            # existing UsdcMultiLendingVault address
